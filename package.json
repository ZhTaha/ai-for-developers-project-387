{
  "name": "ai-for-developers-project-387",
  "version": "1.0.0",
  "description": "Сервис бронирования тайм-слотов для звонков (учебный проект Hexlet, курс «ИИ для разработчиков 2.0»)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-force-exit test/calendar.test.js test/server.test.js && playwright test",
    "lint": "eslint src test public",
    "contract": "tsp compile ./typespec",
    "generate": "npm run contract && node scripts/generate-api-client.js",
    "test:mutation": "node scripts/verify-booking-rule.js",
    "check": "mise run check"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Talgat <talgatzhunis@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "@typespec/rest": "0.88.0",
    "globals": "16.5.0"
  }
}
